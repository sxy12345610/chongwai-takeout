# ===== 基础配置 =====
NODE_ENV=development
PORT=3000

# PostgreSQL 连接串（请替换为本地或云端真实地址，不要提交到 Git）
# 本地安装示例：postgresql://postgres:你的密码@localhost:5432/chongwai_takeout?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chongwai_takeout?schema=public

# JWT 密钥（至少 32 位随机字符串，禁止使用示例值上线）
JWT_SECRET=replace-with-random-64-chars
JWT_REFRESH_SECRET=replace-with-another-random-64-chars
# Access Token 有效期，如 2h、30m
JWT_ACCESS_TTL=2h

# 支付模式：disabled | sandbox | live
# 阶段 1 固定使用 disabled，不接入任何真实支付
PAYMENT_MODE=disabled

# ===== 种子账号（可选，留空则跳过账号初始化）=====
# 仅在本地开发/演示环境使用，禁止提交真实手机号与密码
SEED_USER_PHONE=
SEED_MERCHANT_PHONE=
SEED_DEMO_PASSWORD=

# ===== 微信小程序登录（可选，未配置时 wx-login 不伪造成功）=====
# AppSecret 只能保存在后端环境变量，禁止写入代码或提交 Git
WECHAT_APPID=
WECHAT_SECRET=

# ===== 平台管理员白名单（可选，逗号分隔的 user id）=====
# 命中白名单的用户额外拥有 ADMIN 角色；无需新增数据表
ADMIN_USER_IDS=

# ===== 开发态管理员账号（可选，仅非生产环境生效）=====
# 设置后启动时自动创建该账号，登录即获得 ADMIN 角色，供管理后台联调。
# 生产环境此项不生效，必须使用 ADMIN_USER_IDS 白名单。
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
